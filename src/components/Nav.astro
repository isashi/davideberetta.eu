<nav class="site-nav" aria-label="Navigazione principale">
  <a class="site-nav-mark" href="#top" aria-label="Torna in cima">DB</a>
  <div class="site-nav-links">
    <a href="#about">Chi sono</a>
    <a href="#cosa-faccio">Cosa faccio</a>
    <a href="#progetti">Progetti</a>
    <a href="#contatti">Contatti</a>
  </div>
  {/* "Stack" e "Come lavoro" restano raggiungibili con lo scroll: aggiungerli qui
      renderebbe la nav troppo affollata su schermi piccoli. */}
</nav>

<script>
  const nav = document.querySelector('.site-nav');
  const THRESHOLD = 40;
  let ticking = false;

  function update() {
    if (nav) {
      nav.classList.toggle('is-visible', window.scrollY > THRESHOLD);
    }
    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );

  update();
</script>
